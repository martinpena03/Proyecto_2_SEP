Size=35;html=1;fontStyle=1;fontSize=11;fillColor=#38761d;strokeColor=#274e13;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="78" y="1546" width="40" height="18" as="geometry"/></mxCell><mxCell id="v2-134" value="Actividad Obligatoria / Complementaria cumplida" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;align=left;" vertex="1" parent="1"><mxGeometry x="124" y="1544" width="350" height="22" as="geometry"/></mxCell><mxCell id="v2-135" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;th&gt;Act.&lt;/th&gt;&lt;th&gt;Qué pide&lt;/th&gt;&lt;th&gt;Dónde se cumple&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#cc0000;color:#ffffff;font-weight:bold;padding:0 4px;&quot;&gt;AO1&lt;/span&gt;&lt;/td&gt;&lt;td&gt;Pantalla dinámica + 3 sensores de la booster + modificar 2 registros&lt;/td&gt;&lt;td&gt;Screen Manager → axi_quad_spi_0 → Screen · Accelerometer (power-up), Light_Sensor (tema), Microphone (público) · registros del OPT3001: CONFIG, LOW_LIMIT / HIGH_LIMIT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#cc0000;color:#ffffff;font-weight:bold;padding:0 4px;&quot;&gt;AO2&lt;/span&gt;&lt;/td&gt;&lt;td&gt;≥ 2 interrupciones de timers + 1 del sensor de luz o temperatura&lt;/td&gt;&lt;td&gt;axi_timer_0 (1 ms) y axi_timer_1 (2 ms) → GIC → ISR_handler · INT del OPT3001 → axi_gpio_1 → GIC&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#cc0000;color:#ffffff;font-weight:bold;padding:0 4px;&quot;&gt;AO3&lt;/span&gt;&lt;/td&gt;&lt;td&gt;IP Core propio + función con punteros + parámetros por UART&lt;/td&gt;&lt;td&gt;Debouncer_IP (VHDL, AXI4-Lite) · UART_config → debouncer_init(Debouncer *dev, const DebCfg *cfg)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#38761d;color:#ffffff;font-weight:bold;padding:0 4px;&quot;&gt;AC1&lt;/span&gt;&lt;/td&gt;&lt;td&gt;Máquina de estados&lt;/td&gt;&lt;td&gt;State_Machine: menú, selección, juego, pausa, game over&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#38761d;color:#ffffff;font-weight:bold;padding:0 4px;&quot;&gt;AC2&lt;/span&gt;&lt;/td&gt;&lt;td&gt;Structs, arreglos, punteros, funciones, macros&lt;/td&gt;&lt;td&gt;Game Manager: Note, Song, GameState, chart[], Record[5]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#38761d;color:#ffffff;font-weight:bold;padding:0 4px;&quot;&gt;AC3&lt;/span&gt;&lt;/td&gt;&lt;td&gt;2 periféricos adicionales&lt;/td&gt;&lt;td&gt;Joystick (notas ← ↑ ↓ → y menú) · Btn S1, S2, JOY_SEL&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#38761d;color:#ffffff;font-weight:bold;padding:0 4px;&quot;&gt;AC4&lt;/span&gt;&lt;/td&gt;&lt;td&gt;Boot de la Zybo&lt;/td&gt;&lt;td&gt;BOOT.BIN en SD_Memory (jumper JP5 en SD)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;AC5&lt;/td&gt;&lt;td&gt;VIO e ILA&lt;/td&gt;&lt;td&gt;&lt;i&gt;Pendiente&lt;/i&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#38761d;color:#ffffff;font-weight:bold;padding:0 4px;&quot;&gt;AC6&lt;/span&gt;&lt;/td&gt;&lt;td&gt;Música con buzzer&lt;/td&gt;&lt;td&gt;Sound Manager → TTC0 → EMIO → Buzzer&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#38761d;color:#ffffff;font-weight:bold;padding:0 4px;&quot;&gt;AC7&lt;/span&gt;&lt;/td&gt;&lt;td&gt;Memoria SD&lt;/td&gt;&lt;td&gt;SD_Manager (xilffs) ↔ SDIO0 ↔ SD_Memory: SONG1.SHC y RECORDS.TXT&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="520" y="1330" width="1080" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>