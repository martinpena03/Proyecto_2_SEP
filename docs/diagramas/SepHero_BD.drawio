ll><mxCell id="m-v76" value="" style="shape=singleArrow;whiteSpace=wrap;html=1;arrowWidth=0.45;arrowSize=0.5;direction=north;fillColor=#00C853;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1049" y="212" width="54" height="54" as="geometry"/></mxCell><mxCell id="m-v77" value="" style="shape=singleArrow;whiteSpace=wrap;html=1;arrowWidth=0.45;arrowSize=0.5;direction=south;fillColor=#FFD600;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1121" y="134" width="54" height="54" as="geometry"/></mxCell><mxCell id="m-v78" value="" style="shape=singleArrow;whiteSpace=wrap;html=1;arrowWidth=0.45;arrowSize=0.5;direction=east;fillColor=#FF3D00;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1193" y="326" width="54" height="54" as="geometry"/></mxCell><mxCell id="m-v79" value="" style="shape=singleArrow;whiteSpace=wrap;html=1;arrowWidth=0.45;arrowSize=0.5;direction=west;fillColor=#E040FB;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="977" y="170" width="54" height="54" as="geometry"/></mxCell><mxCell id="m-v80" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="929" y="140" width="24" height="294" as="geometry"/></mxCell><mxCell id="m-v81" value="" style="rounded=0;html=1;fillColor=#FFC400;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="932" y="359.0" width="18" height="72.0" as="geometry"/></mxCell><mxCell id="m-v82" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="1271" y="140" width="24" height="294" as="geometry"/></mxCell><mxCell id="m-v83" value="" style="rounded=0;html=1;fillColor=#FF1744;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1274" y="344.6" width="18" height="86.39999999999999" as="geometry"/></mxCell><mxCell id="m-v84" value="" style="rounded=0;html=1;fillColor=#CCCCCC;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="968" y="446" width="291" height="9" as="geometry"/></mxCell><mxCell id="m-v85" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="968" y="446" width="58.2" height="9" as="geometry"/></mxCell><mxCell id="m-v86" value="&lt;b&gt;Juego normal · tema OSCURO&lt;/b&gt; (poca luz)" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="384" height="20" as="geometry"/></mxCell><mxCell id="m-v87" value="&lt;b&gt;STAR POWER activo&lt;/b&gt; · ×2 por 20 s · notas y bordes azules" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="480" y="470" width="384" height="20" as="geometry"/></mxCell><mxCell id="m-v88" value="&lt;b&gt;Juego normal · tema CLARO&lt;/b&gt; (mucha luz) · rock meter bajo" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="920" y="470" width="384" height="20" as="geometry"/></mxCell><mxCell id="m-v89" value="" style="fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="384" height="384" as="geometry"/></mxCell><mxCell id="m-v90" value="AO1" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#CC0000;strokeColor=#990000;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="350" y="63" width="34" height="15" as="geometry"/></mxCell><mxCell id="m-v91" value="AC3" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#2D7600;strokeColor=#1e5000;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="387" y="63" width="34" height="15" as="geometry"/></mxCell><mxCell id="m-v92" value="" style="fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="480" y="80" width="384" height="384" as="geometry"/></mxCell><mxCell id="m-v93" value="AO1" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#CC0000;strokeColor=#990000;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="827" y="63" width="34" height="15" as="geometry"/></mxCell><mxCell id="m-v94" value="" style="fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="920" y="80" width="384" height="384" as="geometry"/></mxCell><mxCell id="m-v95" value="AO1" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#CC0000;strokeColor=#990000;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1230" y="63" width="34" height="15" as="geometry"/></mxCell><mxCell id="m-v96" value="AO2" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fontSize=9;fontStyle=1;fillColor=#CC0000;strokeColor=#990000;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1267" y="63" width="34" height="15" as="geometry"/></mxCell><mxCell id="m-v97" value="&lt;b&gt;Elementos de la pantalla&lt;/b&gt; (números en la primera pantalla)&lt;ol style=&quot;margin:4px 0 0 18px;padding:0&quot;&gt;&lt;li&gt;Puntaje; aparece ×2 cuando el star power está activo.&lt;/li&gt;&lt;li&gt;Nivel del público (micrófono).&lt;/li&gt;&lt;li&gt;Barra de poder: se llena con aciertos seguidos (STAR_STREAK). Llena + agitar el mando (acelerómetro) → star power.&lt;/li&gt;&lt;li&gt;Rock meter: sube con aciertos y baja con fallos; en 0 → GAME OVER.&lt;/li&gt;&lt;li&gt;Notas-flecha que caen de arriba hacia abajo, cada una en su carril y con el color de su carril.&lt;/li&gt;&lt;li&gt;Receptores: contorno de ← ↑ ↓ → en la línea de golpe. Se acierta apuntando el joystick en esa dirección cuando la nota pasa sobre el receptor (±HIT_WIN_MS).&lt;/li&gt;&lt;li&gt;Bordes de la pista: grises normalmente, azules en star power.&lt;/li&gt;&lt;li&gt;Progreso de la canción (song_ms / duración).&lt;/li&gt;&lt;/ol&gt;El fondo negro / blanco lo decide el sensor de luz (interrupción del OPT3001)." style="html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;fontSize=11;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="600" height="215" as="geometry"/></mxCell><mxCell id="m-v98" value="&lt;b&gt;Joystick → carril → color&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:11px&quot; border=&quot;1&quot; cellpadding=&quot;4&quot;&gt;&lt;tr style=&quot;background-color:#eeeeee&quot;&gt;&lt;th&gt;Joystick&lt;/th&gt;&lt;th&gt;Carril (izq → der)&lt;/th&gt;&lt;th&gt;Lane&lt;/th&gt;&lt;th&gt;Color&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;← izquierda&lt;/td&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;IZQ = 0&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background-color:#E040FB;color:#E040FB;&quot;&gt;████&lt;/span&gt; magenta&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↑ arriba&lt;/td&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;ARRIBA = 1&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background-color:#00C853;color:#00C853;&quot;&gt;████&lt;/span&gt; verde&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↓ abajo&lt;/td&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;ABAJO = 2&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background-color:#FFD600;color:#FFD600;&quot;&gt;████&lt;/span&gt; amarillo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;→ derecha&lt;/td&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;DER = 3&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background-color:#FF3D00;color:#FF3D00;&quot;&gt;████&lt;/span&gt; rojo&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;3&quot;&gt;star power (todas las notas)&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;background-color:#2979FF;color:#2979FF;&quot;&gt;████&lt;/span&gt; azul&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;fillColor=#ffffff;strokeColor=none;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="670" y="510" width="634" height="175" as="geometry"/></mxCell><mxCell id="m-v99" value="&lt;b&gt;Detección de la flecha&lt;/b&gt; (input.c, timer1 cada 2 ms): dx = x − 512, dy = y − 512 (ADC de 10 bit). Si max(|dx|, |dy|) &amp;gt; JOY_UMBRAL, la dirección es la del eje con mayor desviación (no hay diagonales). Cuenta como hit solo el paso CENTRO → dirección; para repetir hay que volver bajo JOY_UMBRAL − JOY_HIST. Verificar en la placa el signo del eje Y.&lt;br&gt;&lt;b&gt;Dibujo:&lt;/b&gt; carriles de 24 px (x = 16–112), flechas de 18×18 px guardadas como sprites const u16 (RGB565) en flash. Solo se redibujan las zonas que cambian en cada frame_flag (~33 FPS), porque el SPI del LCD es lento." style="html=1;whiteSpace=wrap;fillColor=#f6fbf4;strokeColor=#82b366;align=left;verticalAlign=top;fontSize=10;spacing=6;" vertex="1" parent="1"><mxGeometry x="670" y="695" width="634" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>