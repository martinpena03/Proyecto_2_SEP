bre&lt;/th&gt;&lt;th&gt;Acceso&lt;/th&gt;&lt;th&gt;Contenido&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x00&lt;/td&gt;&lt;td&gt;CTRL&lt;/td&gt;&lt;td&gt;R/W&lt;/td&gt;&lt;td&gt;bit0 EN · bit1 IRQ_EN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x04&lt;/td&gt;&lt;td&gt;DEB_MS&lt;/td&gt;&lt;td&gt;R/W&lt;/td&gt;&lt;td&gt;tiempo de antirrebote en ms (desde la UART)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x08&lt;/td&gt;&lt;td&gt;LANE_MASK&lt;/td&gt;&lt;td&gt;R/W&lt;/td&gt;&lt;td&gt;[3:0] carriles habilitados (desde la UART)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x0C&lt;/td&gt;&lt;td&gt;STATE&lt;/td&gt;&lt;td&gt;R&lt;/td&gt;&lt;td&gt;[3:0] botones ya filtrados (nivel)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x10&lt;/td&gt;&lt;td&gt;EDGE&lt;/td&gt;&lt;td&gt;R / W1C&lt;/td&gt;&lt;td&gt;[3:0] flancos de subida pendientes → irq&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;fillColor=#ffffff;strokeColor=none;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="470" y="1160" width="560" height="200" as="geometry"/></mxCell><mxCell id="b-v132" value="&lt;b&gt;Interrupciones&lt;/b&gt; (GIC, sensibles a nivel alto)&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background-color:#eeeeee&quot;&gt;&lt;th&gt;IRQ_F2P&lt;/th&gt;&lt;th&gt;ID&lt;/th&gt;&lt;th&gt;Fuente&lt;/th&gt;&lt;th&gt;Handler (isr.c)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;[0]&lt;/td&gt;&lt;td&gt;61&lt;/td&gt;&lt;td&gt;axi_timer_0 (1 ms)&lt;/td&gt;&lt;td&gt;timer0_isr&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;[1]&lt;/td&gt;&lt;td&gt;62&lt;/td&gt;&lt;td&gt;axi_timer_1 (10 ms)&lt;/td&gt;&lt;td&gt;timer1_isr&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;[2]&lt;/td&gt;&lt;td&gt;63&lt;/td&gt;&lt;td&gt;debouncer_axi_0&lt;/td&gt;&lt;td&gt;deb_isr&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;[3]&lt;/td&gt;&lt;td&gt;64&lt;/td&gt;&lt;td&gt;axi_gpio_1 (S1/S2/SEL + OPT_INT)&lt;/