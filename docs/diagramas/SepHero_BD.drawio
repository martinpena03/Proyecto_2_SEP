ex="1" parent="1"><mxGeometry x="1390" y="780" width="230" height="80" as="geometry"/></mxCell><mxCell id="f-v51" value="&lt;b&gt;isr.c&lt;/b&gt;&lt;br&gt;timer0_isr (1 ms): song_ms++, buzzer_tick(),&lt;br&gt;star_ms−−&lt;br&gt;timer1_isr (2 ms): joy_sample(); c/5: sensors_&lt;br&gt;sample(); c/15: frame_flag (~33 FPS)&lt;br&gt;deb_isr · gpio_isr" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1390" y="880" width="230" height="170" as="geometry"/></mxCell><mxCell id="f-v52" value="&lt;b&gt;sd_storage.c&lt;/b&gt; · SdCtx&lt;br&gt;sd_load_song(&amp;amp;song, &quot;0:/SONG1.SHC&quot;)&lt;br&gt;sd_load / sd_save_records(Record*)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1390" y="1080" width="230" height="90" as="geometry"/></mxCell><mxCell id="f-v53" value="&lt;b&gt;uart_config.c&lt;/b&gt;&lt;br&gt;pide por consola: DEB_MS, BTN_MASK&lt;br&gt;(→ DebCfg), JOY_UMBRAL, UMBRAL_SHAKE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1390" y="1200" width="230" height="90" as="geometry"/></mxCell><mxCell id="f-v54" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1690" y="130" width="400" height="1160" as="geometry"/></mxCell><mxCell id="f-v55" value="&lt;b&gt;game_engine.c&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-family:Consolas,monospace;font-size:10px&quot;&gt;typedef enum { IZQ, ARRIBA, ABAJO, DER } Lane; // ← ↑ ↓ →&lt;br&gt;typedef struct { u32 t_ms; Lane lane; u16 freq; u16 dur; } Note;&lt;br&gt;typedef struct { char name[16]; u16 bpm; u16 n; Note *chart; } Song;&lt;br&gt;typedef struct { u32 score; u16 streak; u8 star_bar;&lt;br&gt;&amp;nbsp; u32 star_ms; s8 rock; u8 theme; } GameState;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.5&quot;&gt;• hit = flecha del joystick == carril de la nota&lt;br&gt;&amp;nbsp; y |t_hit − t_nota| ≤ HIT_WIN_MS&lt;br&gt;• puntos = PTS_NOTA × (star ? 2 : 1)&lt;br&gt;• streak ≥ STAR_STREAK → barra de poder llena&lt;br&gt;• barra llena + shake → &lt;b&gt;STAR POWER&lt;/b&gt; 20 s: ×2, notas y bordes azules&lt;br&gt;• rock meter: acierto +1 / fallo −2; rock = 0 → GAME OVER&lt;br&gt;• público (mic) en el HUD · grito en pantalla final → bonus encore&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1705" y="150" width="370" height="370" as="geometry"/></mxCell><mxCell id="f-v56" value="&lt;b&gt;game_fsm.c&lt;/b&gt; · main()&lt;br&gt;&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;INIT → MENU → SELECCIÓN DE NIVEL → JUEGO ⇄ PAUSA → GAME OVER → MENU&lt;br&gt;MENU también lleva a RÉCORDS y a CONFIG (UART)&lt;br&gt;&lt;i&gt;(detalle en la página 3)&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:Consolas,monospace;font-size:9px&quot;&gt;int main(void) {&lt;br&gt;&amp;nbsp; init_all(&amp;amp;ctx);&amp;nbsp;&amp;nbsp;// GIC, timers, SPI, IIC, SD&lt;br&gt;&amp;nbsp; while (1) {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; if (ctx.frame_flag) {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; fsm_step(&amp;amp;ctx, ui_pop());&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; render_frame(&amp;amp;ctx);&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; ctx.frame_flag = 0;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp; }&lt;br&gt;&amp;nbsp; }&lt;br&gt;}&lt;/span&gt;&lt;br&gt;&lt;br&gt;Tiempo de juego = song_ms (timer0); el dibujo va en el main, nunca dentro de una ISR (el SPI del LCD es lento).&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=10;verticalAlign=middle;align=center;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1705" y="545" width="370" height="730" as="geometry"/></mxCell><mxCell id="f-e57" value="s1, s2, joy_sel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#000000;strokeWidth=1.5;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="f-v9" target="f-v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-e58" value="R: EDGE[2:0], STATE[2:0]&lt;br&gt;W: CTRL, DEB_MS, BTN_MASK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#1f5fbf;strokeWidth=2;dashed=1;dashPattern=8 3;startArrow=block;startFill=1;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="f-v19" target="f-v35"><mxGeometry relative="1" x="0.47" as="geometry"></mxGeometry></mxCell><mxCell id="f-e59" value="edges" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#2D7600;strokeWidth=1.5;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="f-v35" target="f-v45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-e60" value="OK, ATRÁS,&lt;br&gt;PAUSA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=9;labelBackg