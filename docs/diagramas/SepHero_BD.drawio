th="185" height="18" as="geometry"/></mxCell><mxCell id="f-v177" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="292" y="1466" width="1" height="1" as="geometry"/></mxCell><mxCell id="f-v178" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="342" y="1466" width="1" height="1" as="geometry"/></mxCell><mxCell id="f-e179" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#2D7600;strokeWidth=1.5;" edge="1" parent="1" source="f-v177" target="f-v178"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-v180" value="llamada / dato entre módulos C" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="350" y="1458" width="185" height="18" as="geometry"/></mxCell><mxCell id="f-v181" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="292" y="1488" width="1" height="1" as="geometry"/></mxCell><mxCell id="f-v182" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="342" y="1488" width="1" height="1" as="geometry"/></mxCell><mxCell id="f-e183" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="f-v181" target="f-v182"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-v184" value="EMIO (PS → PL → pin)" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="350" y="1480" width="185" height="18" as="geometry"/></mxCell><mxCell id="f-v185" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="292" y="1510" width="1" height="1" as="geometry"/></mxCell><mxCell id="f-v186" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="342" y="1510" width="1" height="1" as="geometry"/></mxCell><mxCell id="f-e187" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#d79b00;strokeWidth=1.5;dashed=1;dashPattern=2 2;" edge="1" parent="1" source="f-v185" target="f-v186"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-v188" value="MIO (directo al PS, sin PL)" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="350" y="1502" width="185" height="18" as="geometry"/></mxCell><mxCell id="f-v189" value="&lt;span style=&quot;background-color:#CC0000;color:#ffffff;font-weight:bold;padding:0px 3px;&quot;&gt;AOn&lt;/span&gt; &lt;span style=&quot;background-color:#2D7600;color:#ffffff;font-weight:bold;padding:0px 3px;&quot;&gt;ACn&lt;/span&gt;&amp;nbsp; Actividad Obligatoria / Complementaria que se cumple en ese bloque" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="1536" width="500" height="20" as="geometry"/></mxCell><mxCell id="f-v190" value="&lt;i&gt;FCLK_CLK0 (50 MHz) y peripheral_aresetn llegan a todos los IP de la PL; no se dibujan para no saturar.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="32" y="1560" width="500" height="26" as="geometry"/></mxCell><mxCell id="f-v191" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-size:10px&quot; border=&quot;1&quot; cellpadding=&quot;3&quot;&gt;&lt;tr style=&quot;background-color:#eeeeee&quot;&gt;&lt;th&gt;Act.&lt;/th&gt;&lt;th&gt;Qué pide&lt;/th&gt;&lt;th&gt;Dónde se cumple en Sep Hero&lt;/th&gt;&lt;th&gt;Vivado / Vitis&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#CC0000;color:#ffffff;font-weight:bold;padding:0px 3px;&quot;&gt;AO1&lt;/span&gt;&lt;/td&gt;&lt;td&gt;Pantalla dinámica + 3 sensores de la booster + modificar 2 registros&lt;/td&gt;&lt;td&gt;render.c: pista ← ↑ ↓ → con receptores y notas-flecha, puntaje, barra de poder y rock meter (página 4) · acelerómetro (shake activa el poder) · sensor de luz (modo claro/oscuro) · micrófono (público y encore) · registros del OPT3001: CONFIG 0x01 y LOW_LIMIT 0x02 / HIGH_LIMIT 0x03&lt;/td&gt;&lt;td&gt;Ambos&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#CC0000;color:#ffffff;font-weight:bold;padding:0px 3px;&quot;&gt;AO2&lt;/span&gt;&lt;/td&gt;&lt;td&gt;≥ 2 interrupciones de timers hechos en Vivado + 1 interrupción del sensor de luz o temperatura&lt;/td&gt;&lt;td&gt;axi_timer_0 (1 ms: reloj de la canción y secuenciador del buzzer) · axi_timer_1 (2 ms: joystick; acelerómetro y mic cada 10 ms; frame_flag) · pin INT del OPT3001 → axi_gpio_1 → GIC (cambio de tema)&lt;/td&gt;&lt;td&gt;Vivado: IP + IRQ_F2P · Vitis: isr.c&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#CC0000;color:#ffffff;font-weight:bold;padding:0px 3px;&quot;&gt;AO3&lt;/span&gt;&lt;/td&gt;&lt;td&gt;IP Core propio que habla con un periférico y con el procesador; init con punteros; parámetros por UART&lt;/td&gt;&lt;td&gt;debouncer_axi_0 (VHDL, AXI4-Lite + irq) sobre S1, S2 y JOY_SEL de la booster · debouncer_init(Debouncer *dev, const DebCfg *cfg) con DEB_MS y BTN_MASK escritos en la consola (uart_config.c)&lt;/td&gt;&lt;td&gt;Ambos&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#2D7600;color:#ffffff;font-weight:bold;padding:0px 3px;&quot;&gt;AC1&lt;/span&gt;&lt;/td&gt;&lt;td&gt;Máquina de estados&lt;/td&gt;&lt;td&gt;game_fsm.c: INIT, MENU, RÉCORDS, CONFIG, SELECCIÓN, JUEGO, PAUSA, GAME OVER, más la sub-FSM del star power (página 3)&lt;/td&gt;&lt;td&gt;Vitis&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#2D7600;color:#ffffff;font-weight:bold;padding:0px 3px;&quot;&gt;AC2&lt;/span&gt;&lt;/td&gt;&lt;td&gt;Structs, arreglos, punteros, funciones y macros&lt;/td&gt;&lt;td&gt;Lane (enum), Note, Song, GameState, Buzzer_t, Debouncer, DebCfg, Record[5] · chart[], cola circular de hits y sprites const u16 arrow_spr[4][18*18] · macros HIT_WIN_MS, JOY_UMBRAL, STAR_STREAK, STAR_MS y offsets de registros&lt;/td&gt;&lt;td&gt;Vitis&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#2D7600;color:#ffffff;font-weight:bold;padding:0px 3px;&quot;&gt;AC3&lt;/span&gt;&lt;/td&gt;&lt;td&gt;2 periféricos adicionales (distintos de los de AO1)&lt;/td&gt;&lt;td&gt;Joystick (las 4 flechas del juego ← ↑ ↓ → y navegar los menús) y botones de la booster (S1 / S2 / JOY_SEL, filtrados por el IP propio)&lt;/td&gt;&lt;td&gt;Ambos&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#2D7600;color:#ffffff;font-weight:bold;padding:0px 3px;&quot;&gt;AC4&lt;/span&gt;&lt;/td&gt;&lt;td&gt;Boot de la Zybo&lt;/td&gt;&lt;td&gt;BOOT.BIN (FSBL + bitstream + sep_hero.elf) en la microSD, jumper JP5 en SD&lt;/td&gt;&lt;td&gt;Vitis (Create Boot Image)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;AC5&lt;/td&gt;&lt;td&gt;VIO e ILA&lt;/td&gt;&lt;td&gt;&lt;i&gt;Pendiente: no se incluye en esta versión del diagrama&lt;/i&gt;&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#2D7600;color:#ffffff;font-weight:bold;padding:0px 3px;&quot;&gt;AC6&lt;/span&gt;&lt;/td&gt;&lt;td&gt;Música con el buzzer&lt;/td&gt;&lt;td&gt;TTC0 → EMIO → BUZZER_PWM; audio.c toca la melodía de la canción sin bloquear (avanza en timer0_isr) y jingles de menú y game over&lt;/td&gt;&lt;td&gt;Ambos&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;text-align:center&quot;&gt;&lt;span style=&quot;background-color:#2D7600;color:#ffffff;font-weight:bold;padding:0px 3px;&quot;&gt;AC7&lt;/span&gt;&lt;/td&gt;&lt;td&gt;Usar una memoria SD&lt;/td&gt;&lt;td&gt;SONG1.SHC (melodía + notas de la pista) y RECORDS.TXT (top 5) con xilffs&lt;/td&gt;&lt;td&gt;Vitis&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="html=1;whiteSpace=wrap;overflow=fill;fillColor=#ffffff;strokeColor=none;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="560" y="1340" width="1530" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="b" name="2 - Nivel block design (Vivado)"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1440" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b-v1" value="&lt;b style=&quot;font-size:18px&quot;&gt;Sep Hero — block design de Vivado (design_1) · ARM Cortex-A9 del PS, sin MicroBlaze&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="1500" height="30" as="geometry"/></mxCell><mxCell id="b-v2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeWidth=2;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="1590" height="1080" as="geometry"/></mxCell><mxCell id="b-v3" value="&lt;b&gt;design_1_wrapper&lt;/b&gt; → block design &lt;b&gt;design_1&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;vertica